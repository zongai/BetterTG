<Window x:Class="BetterTG.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterTG.Windows — 扩展设置"
        Height="640" Width="520"
        MinHeight="480" MinWidth="400"
        Background="#F3F3F3">
  <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="480">
      <TextBlock Text="BetterTG 扩展" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16"
                 Text="本程序为扩展库设置宿主与功能演示。完整 Telegram 客户端需集成到 Unigram（见包内 Docs/INTEGRATION.md）。"/>

      <GroupBox Header="消息翻译" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox Content="启用自动翻译" IsChecked="{Binding AutoTranslateEnabled}" Margin="0,4"/>
          <CheckBox Content="显示双语（原文 + 译文）" IsChecked="{Binding ShowBilingual}" Margin="0,4"/>
          <TextBlock Text="目标语言代码" Margin="0,8,0,2"/>
          <TextBox Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="引擎顺序（逗号分隔）" Margin="0,8,0,2"/>
          <TextBox Text="{Binding EngineOrder, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="DeepL Keys（多行）" Margin="0,8,0,2"/>
          <TextBox Text="{Binding DeepLKeys, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="Azure Key" Margin="0,8,0,2"/>
          <TextBox Text="{Binding AzureKey, UpdateSourceTrigger=PropertyChanged}"/>
          <CheckBox Content="启用翻译缓存" IsChecked="{Binding TranslationCacheEnabled}" Margin="0,8,0,0"/>
          <Button Content="清空翻译缓存" Margin="0,8,0,0" Padding="12,4"
                  HorizontalAlignment="Left" Click="OnClearCache"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="内容过滤" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox Content="启用内容过滤" IsChecked="{Binding ContentFilterEnabled}" Margin="0,4"/>
          <CheckBox Content="隐藏赞助消息 (Ads)" IsChecked="{Binding HideAds}" Margin="0,4"/>
          <TextBlock Text="黑名单（每行一词）" Margin="0,8,0,2"/>
          <TextBox Text="{Binding BlacklistRaw, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="白名单（每行一词，优先于黑名单）" Margin="0,8,0,2"/>
          <TextBox Text="{Binding WhitelistRaw, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="下载与缓存" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="{Binding ChunkLabel}" Margin="0,0,0,4"/>
          <Slider Minimum="4" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding DownloadChunkCount}"/>
          <CheckBox Content="显示下载速度" IsChecked="{Binding ShowDownloadSpeed}" Margin="0,8,0,0"/>
          <TextBlock Text="缓存最长天数" Margin="0,8,0,2"/>
          <TextBox Text="{Binding CacheMaxAgeDays, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="缓存上限 (MB)" Margin="0,8,0,2"/>
          <TextBox Text="{Binding CacheMaxSizeMb, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="界面" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <CheckBox Content="群组/频道气泡近满宽" IsChecked="{Binding FullWidthBubblesInGroups}" Margin="0,4"/>
          <CheckBox Content="隐藏频道旁路分享按钮" IsChecked="{Binding HideChannelShareButton}" Margin="0,4"/>
          <TextBlock Text="{Binding FontScaleLabel}" Margin="0,8,0,4"/>
          <Slider Minimum="85" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                  Value="{Binding FontScalePercent}"/>
        </StackPanel>
      </GroupBox>

      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>

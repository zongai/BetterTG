<?xml version="1.0" encoding="utf-8"?>
<!--
  BetterTG.Windows — Settings hub page
  Integrate into Unigram navigation: register route "BetterTGExtensions" → this page.
  Style intentionally simple Fluent; host may restyle with Unigram resources.
-->
<Page
    x:Class="BetterTG.Windows.Views.Settings.BetterTGExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="8" MaxWidth="720">
            <TextBlock Text="BetterTG 扩展" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

            <TextBlock Text="消息翻译" Opacity="0.7" Margin="0,8,0,4"/>
            <ToggleSwitch Header="自动翻译" IsOn="{x:Bind ViewModel.AutoTranslateEnabled, Mode=TwoWay}"/>
            <HyperlinkButton Content="自动翻译详细设置…" Click="OnAutoTranslateClick"/>

            <TextBlock Text="内容过滤" Opacity="0.7" Margin="0,16,0,4"/>
            <ToggleSwitch Header="启用内容过滤" IsOn="{x:Bind ViewModel.ContentFilterEnabled, Mode=TwoWay}"/>
            <ToggleSwitch Header="隐藏赞助消息 (Ads)" IsOn="{x:Bind ViewModel.HideAds, Mode=TwoWay}"/>
            <HyperlinkButton Content="黑名单 / 白名单…" Click="OnContentFilterClick"/>

            <TextBlock Text="下载与缓存" Opacity="0.7" Margin="0,16,0,4"/>
            <TextBlock Text="分片数 (4–32)"/>
            <Slider Minimum="4" Maximum="32" StepFrequency="1"
                    Value="{x:Bind ViewModel.DownloadChunkCount, Mode=TwoWay}"/>
            <ToggleSwitch Header="显示下载速度" IsOn="{x:Bind ViewModel.ShowDownloadSpeed, Mode=TwoWay}"/>
            <HyperlinkButton Content="缓存清理设置…" Click="OnDownloadCacheClick"/>

            <TextBlock Text="界面" Opacity="0.7" Margin="0,16,0,4"/>
            <ToggleSwitch Header="群组/频道气泡近满宽" IsOn="{x:Bind ViewModel.FullWidthBubblesInGroups, Mode=TwoWay}"/>
            <ToggleSwitch Header="隐藏频道旁路分享按钮" IsOn="{x:Bind ViewModel.HideChannelShareButton, Mode=TwoWay}"/>
            <TextBlock Text="{x:Bind ViewModel.MessageFontScalePercent, Mode=OneWay, StringFormat='消息文字大小: {0}%'}"/>
            <Slider Minimum="85" Maximum="150" StepFrequency="5"
                    Value="{x:Bind FontScalePercent, Mode=TwoWay}"/>
        </StackPanel>
    </ScrollViewer>
</Page>

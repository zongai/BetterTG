<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Core library for CI and embedding into Unigram.
    XAML pages under Views/ are reference implementations — compile them inside
    the Unigram host project (see Docs/INTEGRATION.md), not in this library.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BetterTG.Windows</RootNamespace>
    <AssemblyName>BetterTG.Windows</AssemblyName>
    <Description>BetterTG fork extensions for Unigram (Windows). Does not affect the iOS client.</Description>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models\**\*.cs" />
    <Compile Include="Services\**\*.cs" />
    <Compile Include="Helpers\**\*.cs" />
    <Compile Include="Controls\**\*.cs" />
    <Compile Include="ViewModels\**\*.cs" />
  </ItemGroup>

  <!-- Views/*.xaml + code-behind require WinUI; keep as content for host projects -->
  <ItemGroup>
    <None Include="Views\**\*" />
    <None Include="Docs\**\*" />
    <None Include="README.md" />
  </ItemGroup>
</Project>

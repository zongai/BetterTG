<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BetterTG.Windows.Views.Settings.DownloadCacheSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="10" MaxWidth="720">
            <TextBlock Text="下载与缓存" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>

            <TextBlock Text="多线程分片数（前台立即生效）"/>
            <Slider Minimum="4" Maximum="32" StepFrequency="1"
                    Value="{x:Bind ViewModel.DownloadChunkCount, Mode=TwoWay}"/>
            <TextBlock Text="{x:Bind ViewModel.DownloadChunkCount, Mode=OneWay, StringFormat='当前: {0}'}"/>

            <ToggleSwitch Header="显示下载速度" IsOn="{x:Bind ViewModel.ShowDownloadSpeed, Mode=TwoWay}"/>

            <TextBlock Text="缓存最长保留天数（0 = 不按时间清理）" Margin="0,12,0,0"/>
            <NumberBox Minimum="0" Maximum="365" SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.CacheMaxAgeDays, Mode=TwoWay}"/>

            <TextBlock Text="缓存上限 (MB，0 = 不按容量清理)"/>
            <NumberBox Minimum="0" Maximum="102400" SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.CacheMaxSizeMb, Mode=TwoWay}"/>

            <Button Content="立即清理缓存" Command="{x:Bind ViewModel.RunCleanupCommand}"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"/>
            <TextBlock Text="注意：清理前需由宿主设置 CacheRoots 为 Unigram 媒体缓存目录。"
                       Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
